<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Trap Model — FXDARWISH</title>
<meta name="theme-color" content="#0a0b0e">
<meta name="description" content="The Trap Model — the simple concept the FXDARWISH strategy is built on. Download the full breakdown as a PDF.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0a0b0e; --bg2:#0c0e16; --panel:#101320; --line:rgba(45,107,228,.22);
  --ink:#edeef4; --muted:#9a9fb5; --faint:#5c6076;
  --blue:#1a3fa3; --blue2:#2d6be4; --blue3:#5b8def; --up:#46d3a1;
  --maxw:1120px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:'Manrope',system-ui,-apple-system,Segoe UI,sans-serif;
  -webkit-font-smoothing:antialiased;line-height:1.5;overflow-x:hidden}
a{color:inherit;text-decoration:none}
.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}

/* ambient brand background */
.bgfx{position:fixed;inset:0;z-index:0;pointer-events:none}
.bgfx .glow{position:absolute;inset:0;
  background:radial-gradient(760px 420px at 50% -6%,rgba(45,107,228,.20),transparent 62%),
             radial-gradient(600px 500px at 92% 8%,rgba(45,107,228,.10),transparent 60%)}
.bgfx .grid{position:absolute;inset:0;opacity:.5;
  background-image:linear-gradient(rgba(255,255,255,.03) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(255,255,255,.03) 1px,transparent 1px);
  background-size:46px 46px;
  -webkit-mask-image:radial-gradient(120% 80% at 50% 0%,#000 20%,transparent 78%);
          mask-image:radial-gradient(120% 80% at 50% 0%,#000 20%,transparent 78%)}
.content{position:relative;z-index:1}

/* header */
header{display:flex;align-items:center;justify-content:space-between;padding:26px 0}
header .brand img{height:34px;display:block}
header .site{font-weight:700;color:var(--muted);font-size:14px;letter-spacing:.2px}
header .site b{color:var(--ink)}

/* hero */
.hero{display:grid;grid-template-columns:1.02fr .98fr;gap:56px;align-items:center;
  padding:40px 0 30px}
.kicker{display:inline-flex;align-items:center;gap:9px;color:var(--blue3);
  font-weight:700;font-size:13.5px;margin-bottom:18px}
.kicker .dot{width:7px;height:7px;border-radius:50%;background:var(--blue2);
  box-shadow:0 0 0 4px rgba(45,107,228,.16)}
h1{font-weight:800;font-size:clamp(44px,6vw,76px);line-height:.98;margin:0 0 18px;
  letter-spacing:-.02em}
h1 .sub{display:block;font-size:clamp(19px,2.4vw,26px);font-weight:700;
  color:var(--ink);letter-spacing:-.01em;margin-top:14px}
.lead{color:var(--muted);font-size:16.5px;max-width:46ch;margin:0 0 26px}
.actions{display:flex;flex-wrap:wrap;gap:14px;align-items:center}
.btn{border:0;cursor:pointer;font-family:inherit;font-weight:800;font-size:15.5px;
  padding:15px 26px;border-radius:13px;color:#fff;
  background:linear-gradient(180deg,var(--blue2),var(--blue));
  box-shadow:0 14px 30px -12px rgba(45,107,228,.7),inset 0 1px 0 rgba(255,255,255,.18);
  transition:transform .12s ease,box-shadow .12s ease}
.btn:hover{transform:translateY(-1px);box-shadow:0 18px 38px -12px rgba(45,107,228,.8)}
.btn:active{transform:translateY(0)}
.btn:focus-visible{outline:2px solid var(--blue3);outline-offset:3px}
.btn.ghost{background:transparent;color:var(--ink);
  border:1px solid rgba(255,255,255,.14);box-shadow:none;font-weight:700}
.btn.ghost:hover{border-color:var(--blue2);color:#fff}
.meta{display:flex;gap:18px;margin-top:22px;color:var(--faint);font-size:13px;
  font-weight:600;flex-wrap:wrap}
.meta span{display:inline-flex;align-items:center;gap:7px}
.meta i{width:5px;height:5px;border-radius:50%;background:var(--blue2);display:inline-block}

/* stacked cover preview */
.deck{position:relative;justify-self:center;width:100%;max-width:420px;aspect-ratio:4/5}
.deck .card{position:absolute;inset:0;border-radius:16px;overflow:hidden;
  background:#0d1018;border:1px solid rgba(255,255,255,.07);
  box-shadow:0 40px 80px -40px rgba(0,0,0,.9)}
.deck .c3{transform:rotate(6deg) translate(26px,14px);opacity:.5}
.deck .c2{transform:rotate(-4deg) translate(-20px,8px);opacity:.75}
.deck .c1{box-shadow:0 50px 90px -34px rgba(6,12,30,.95),0 0 0 1px rgba(45,107,228,.25)}
.deck img{width:100%;height:100%;object-fit:cover;display:block}
.deck .tag{position:absolute;left:14px;bottom:14px;z-index:5;
  background:rgba(10,11,14,.72);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.12);border-radius:999px;
  padding:7px 13px;font-size:12px;font-weight:700;color:var(--ink)}

/* viewer */
.viewer{padding:48px 0 20px}
.viewer h2{font-size:22px;font-weight:800;margin:0 0 4px;letter-spacing:-.01em}
.viewer p{color:var(--muted);margin:0 0 22px;font-size:14.5px}
.stage{position:relative;background:var(--bg2);border:1px solid rgba(255,255,255,.07);
  border-radius:18px;padding:18px;display:flex;justify-content:center;overflow:hidden}
.stage::before{content:"";position:absolute;inset:0;
  background:radial-gradient(600px 300px at 50% -20%,rgba(45,107,228,.12),transparent 60%)}
.stage img{position:relative;max-height:74vh;width:auto;max-width:100%;
  border-radius:10px;box-shadow:0 30px 60px -30px rgba(0,0,0,.9)}
.nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;
  width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.14);
  background:rgba(12,14,22,.7);backdrop-filter:blur(8px);color:var(--ink);
  font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  transition:border-color .12s,background .12s}
.nav:hover{border-color:var(--blue2);background:rgba(20,26,44,.85)}
.nav:focus-visible{outline:2px solid var(--blue3);outline-offset:2px}
.nav.prev{left:14px} .nav.next{right:14px}
.count{position:absolute;right:16px;bottom:14px;z-index:3;color:var(--muted);
  font-size:13px;font-weight:700;background:rgba(10,11,14,.6);
  padding:5px 11px;border-radius:999px;border:1px solid rgba(255,255,255,.08)}
.film{display:flex;gap:12px;overflow-x:auto;padding:16px 2px 6px;
  scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch}
.film::-webkit-scrollbar{height:8px}
.film::-webkit-scrollbar-thumb{background:rgba(255,255,255,.12);border-radius:8px}
.thumb{flex:0 0 auto;width:96px;aspect-ratio:4/5;padding:0;border-radius:9px;
  overflow:hidden;cursor:pointer;background:none;scroll-snap-align:center;
  border:1.5px solid transparent;opacity:.55;transition:opacity .15s,border-color .15s}
.thumb img{width:100%;height:100%;object-fit:cover;display:block}
.thumb:hover{opacity:.85}
.thumb[aria-current="true"]{opacity:1;border-color:var(--blue2)}
.thumb:focus-visible{outline:2px solid var(--blue3);outline-offset:2px}

/* closing download */
.close{text-align:center;padding:56px 0 40px}
.close h2{font-size:clamp(26px,4vw,40px);font-weight:800;letter-spacing:-.02em;margin:0 0 12px}
.close p{color:var(--muted);max-width:40ch;margin:0 auto 26px}

footer{border-top:1px solid rgba(255,255,255,.07);margin-top:20px;
  padding:30px 0 48px;display:flex;align-items:center;justify-content:space-between;
  gap:16px;flex-wrap:wrap}
footer img{height:40px;opacity:.95}
footer .u{color:var(--muted);font-weight:700;font-size:14px}

/* mobile sticky bar */
.sticky{position:fixed;left:0;right:0;bottom:0;z-index:20;display:none;
  padding:12px 16px calc(12px + env(safe-area-inset-bottom));
  background:linear-gradient(180deg,rgba(10,11,14,0),rgba(10,11,14,.92) 32%);
  }
.sticky .btn{width:100%;justify-content:center;display:flex}

@media (max-width:860px){
  .hero{grid-template-columns:1fr;gap:36px;padding:26px 0 8px}
  .deck{max-width:320px;margin-top:6px}
  .deck .c3,.deck .c2{display:none}
  .stage img{max-height:64vh}
  .sticky{display:block}
  .close{padding:44px 0 90px}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto}}
</style>
</head>
<body>
<div class="bgfx"><div class="glow"></div><div class="grid"></div></div>
<div class="content">
<div class="wrap">

  <header>
    <span class="brand"><img src="data:image/png;base64," alt="FXDARWISH"></span>
    <span class="site"><b>fxdarwish.com</b> · Trading with Precision</span>
  </header>

  <section class="hero">
    <div>
      <span class="kicker"><span class="dot"></span>Strategy breakdown</span>
      <h1>Trap Model
        <span class="sub">The simple concept our strategy is built on.</span>
      </h1>
      <p class="lead">A deep dive into the mechanics of price movement — how the market
        induces traders, traps them, then expands in both directions. Nine slides, bullish
        and bearish, with live chart examples.</p>
      <div class="actions">
        <button class="btn" id="dl">Download PDF</button>
        <a class="btn ghost" href="#viewer">Preview slides</a>
      </div>
      <div class="meta">
        <span><i></i>PDF document</span>
        <span><i></i>9 slides</span>
        <span><i></i>1080 × 1350</span>
      </div>
    </div>
    <div class="deck" aria-hidden="true">
      <div class="card c3"><img id="d3" alt=""></div>
      <div class="card c2"><img id="d2" alt=""></div>
      <div class="card c1"><img id="d1" alt="">
        <span class="tag">All 9 slides inside</span></div>
    </div>
  </section>

  <section class="viewer" id="viewer">
    <h2>Read it before you download</h2>
    <p>Page through the full carousel — tap a slide or use the arrows.</p>
    <div class="stage">
      <button class="nav prev" id="prev" aria-label="Previous slide">‹</button>
      <img id="stage-img" alt="Trap Model slide 1">
      <button class="nav next" id="next" aria-label="Next slide">›</button>
      <span class="count" id="count">01 / 09</span>
    </div>
    <div class="film" id="film">
      <button class="thumb" data-i="0" aria-label="Go to slide 1"><img loading="lazy" alt="Trap Model slide 1: Cover"></button>
<button class="thumb" data-i="1" aria-label="Go to slide 2"><img loading="lazy" alt="Trap Model slide 2: The 3 Step Model"></button>
<button class="thumb" data-i="2" aria-label="Go to slide 3"><img loading="lazy" alt="Trap Model slide 3: Inducement"></button>
<button class="thumb" data-i="3" aria-label="Go to slide 4"><img loading="lazy" alt="Trap Model slide 4: Trap"></button>
<button class="thumb" data-i="4" aria-label="Go to slide 5"><img loading="lazy" alt="Trap Model slide 5: Expansion"></button>
<button class="thumb" data-i="5" aria-label="Go to slide 6"><img loading="lazy" alt="Trap Model slide 6: Examples"></button>
<button class="thumb" data-i="6" aria-label="Go to slide 7"><img loading="lazy" alt="Trap Model slide 7: Examples"></button>
<button class="thumb" data-i="7" aria-label="Go to slide 8"><img loading="lazy" alt="Trap Model slide 8: Examples"></button>
<button class="thumb" data-i="8" aria-label="Go to slide 9"><img loading="lazy" alt="Trap Model slide 9: Examples"></button>
    </div>
  </section>

  <section class="close">
    <h2>Get the full Trap Model</h2>
    <p>The complete breakdown, yours to keep and revisit on any chart.</p>
    <button class="btn" id="dl2">Download PDF</button>
  </section>

  <footer>
    <img src="data:image/png;base64," alt="FXDARWISH">
    <span class="u">fxdarwish.com</span>
  </footer>

</div>
</div>

<div class="sticky"><button class="btn" id="dl3">Download PDF</button></div>

<script>
const PDF_B64 = "";
const SLIDES = ["data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,","data:image/jpeg;base64,"];
const FILE = "FXDARWISH_Trap_Model.pdf";

function downloadPDF(){
  try{
    const bin = atob(PDF_B64);
    const len = bin.length, bytes = new Uint8Array(len);
    for(let i=0;i<len;i++) bytes[i]=bin.charCodeAt(i);
    const blob = new Blob([bytes],{type:"application/pdf"});
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href=url; a.download=FILE; document.body.appendChild(a); a.click();
    a.remove(); setTimeout(()=>URL.revokeObjectURL(url),1500);
  }catch(e){ window.open("data:application/pdf;base64,"+PDF_B64); }
}
["dl","dl2","dl3"].forEach(id=>document.getElementById(id).addEventListener("click",downloadPDF));

// gallery
let cur=0;
const img=document.getElementById("stage-img");
const count=document.getElementById("count");
const film=document.getElementById("film");
const thumbs=[...document.querySelectorAll(".thumb")];
thumbs.forEach((t,k)=>t.querySelector("img").src=SLIDES[k]);
document.getElementById("d1").src=SLIDES[0];
document.getElementById("d2").src=SLIDES[1];
document.getElementById("d3").src=SLIDES[4];
function pad(n){return String(n).padStart(2,"0");}
function show(i){
  cur=(i+SLIDES.length)%SLIDES.length;
  img.src=SLIDES[cur];
  img.alt="Trap Model slide "+(cur+1);
  count.textContent=pad(cur+1)+" / "+pad(SLIDES.length);
  thumbs.forEach((t,k)=>t.setAttribute("aria-current",k===cur?"true":"false"));
  thumbs[cur].scrollIntoView({inline:"center",block:"nearest",behavior:"smooth"});
}
document.getElementById("prev").addEventListener("click",()=>show(cur-1));
document.getElementById("next").addEventListener("click",()=>show(cur+1));
thumbs.forEach(t=>t.addEventListener("click",()=>show(+t.dataset.i)));
document.addEventListener("keydown",e=>{
  if(e.key==="ArrowLeft")show(cur-1);
  if(e.key==="ArrowRight")show(cur+1);
});
show(0);
</script>
</body>
</html>
